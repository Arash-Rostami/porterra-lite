# Copy to .env.test (gitignored) and adjust if your Docker Compose MySQL uses different
# credentials. Defaults below match docker-compose.yml's defaults exactly.
#
# !!! WARNING — READ BEFORE COPYING THIS FILE !!!
# MYSQL_DATABASE below is "porterra-lite" — the EXACT SAME database name that
# docker-compose.yml creates and that a normal `npm run dev` setup connects to.
# `npm run test:integration` TRUNCATES all 6 tables before every single test
# (see src/lib/testSupport/testDb.js's resetTestDb). If you copy this file as-is
# and point it at a database you actually use for development, running the
# integration suite WILL DESTROY that data.
# Before running the integration suite, either:
#   - run a disposable/throwaway Docker Compose MySQL instance dedicated to
#     testing (different container/volume than your dev one), or
#   - create and migrate (via db/schema.sql) a separate database with its own
#     name, and set MYSQL_DATABASE below to that name instead.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=porterra-lite
